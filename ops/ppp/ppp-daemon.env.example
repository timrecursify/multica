# Copy to /etc/multica/ppp-daemon.env (mode 0600). Do not put credentials in
# this file; the daemon reads the ppp-prod-codex profile token from its local
# Multica config created by `multica login --profile ppp-prod-codex`.
MULTICA_SERVER_URL=<PPP_MULTICA_SERVER_URL>
MULTICA_WORKSPACES_ROOT=/var/lib/multica-ppp/workspaces
MULTICA_CODEX_PATH=/usr/local/bin/codex
MULTICA_DAEMON_ALLOWED_PROVIDERS=codex
