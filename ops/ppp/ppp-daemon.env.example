# Documentation only: the installer generates the live file and never copies
# this example verbatim. Do not put credentials here; the daemon reads the
# ppp-prod-codex token from ~/.multica/profiles/ppp-prod-codex/config.json.
MULTICA_SERVER_URL=https://multica.ai
MULTICA_WORKSPACES_ROOT=/var/lib/multica-ppp/workspaces
MULTICA_CODEX_PATH=/usr/bin/codex
MULTICA_DAEMON_ALLOWED_PROVIDERS=codex
