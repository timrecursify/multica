[Unit]
Description=Multica Archiver
After=network-online.target
Wants=network-online.target

[Service]
User=gsp-multica
Group=gsp-multica
Slice=gsp.slice
WorkingDirectory=/opt/gsp/multica-workers/multica-archiver
EnvironmentFile=/etc/gsp/multica/multica-archiver.env
ExecStart=/usr/bin/node /opt/gsp/multica-workers/multica-archiver/multica-archiver.cjs
ProtectSystem=strict
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
