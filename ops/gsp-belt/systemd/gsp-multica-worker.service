[Unit]
Description=GSP Multica Worker
After=network-online.target
Wants=network-online.target

[Service]
User=gsp-multica
Group=gsp-multica
Slice=gsp.slice
WorkingDirectory=/opt/gsp/multica-workers/gsp-multica-worker
EnvironmentFile=/etc/gsp/multica/daemon.env
ExecStart=/bin/bash /opt/gsp/multica-workers/gsp-multica-worker/multica-daemon-wrapper.sh
ProtectSystem=strict
ReadWritePaths=/var/lib/gsp-multica /var/lib/gsp/multica
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
