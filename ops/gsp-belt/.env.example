# GSP belt operator secrets — COPY THIS FILE, fill in real values, keep it out
# of Git. The deploy tool reads it via GSP_BELT_ENV_FILE; the relay launcher
# falls back to this example only to validate presence of the required keys.
# This template is a checked-in EXAMPLE with clearly-invalid placeholders.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:25432/gsp_multica?sslmode=disable
RELAY_AGENT_SECRET=CHANGE_ME_RELAY_AGENT_SECRET
GSP_WORKSPACE_ID=CHANGE_ME_WORKSPACE_ID
MULTICA_WORKSPACE_ID=CHANGE_ME_WORKSPACE_ID
# 0 halts task creation; unset means 25
RECONCILE_MAX_CREATE_PER_CYCLE=25
# 1 halts the reconcile cycle before any database access
RECONCILE_DISPATCH_HOLD=0
