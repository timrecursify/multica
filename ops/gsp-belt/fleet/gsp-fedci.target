[Unit]
Description=GSP 14-runner federation CI pool
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/opt/gsp/runners/ppp-ci-1
ConditionPathExists=!/opt/gsp/runners/ppp-ci-2
ConditionPathExists=!/opt/gsp/runners/ppp-ci-3
ConditionPathExists=!/opt/gsp/runners/ppp-ci-4
ConditionPathExists=!/opt/gsp/runners/ppp-ci-5
ConditionPathExists=!/opt/gsp/runners/ppp-ci-6
ConditionPathExists=!/opt/gsp/runners/ppp-ci-7
ConditionPathExists=!/opt/gsp/runners/ppp-ci-8
ConditionPathExists=!/opt/gsp/runners/ppp-ci-9
ConditionPathExists=!/opt/gsp/runners/ppp-ci-10
ConditionPathExists=!/opt/gsp/runners/ppp-ci-11
ConditionPathExists=!/opt/gsp/runners/ppp-ci-12
ConditionPathExists=!/opt/gsp/runners/ppp-ci-13
ConditionPathExists=!/opt/gsp/runners/ppp-ci-14
ConditionPathExists=!/opt/gsp/runners/ppp-ci-15
ConditionPathExists=!/opt/gsp/runners/ppp-ci-16
Wants=gsp-runner-fedci@gspdesk-1.service
Wants=gsp-runner-fedci@skcli-1.service
Wants=gsp-runner-fedci@skcli-2.service
Wants=gsp-runner-fedci@skcli-3.service
Wants=gsp-runner-fedci@pppci-1.service
Wants=gsp-runner-fedci@pppci-2.service
Wants=gsp-runner-fedci@pppci-3.service
Wants=gsp-runner-fedci@pppci-4.service
Wants=gsp-runner-fedci@pppci-5.service
Wants=gsp-runner-fedci@pppci-6.service
Wants=gsp-runner-fedci@pppci-7.service
Wants=gsp-runner-fedci@pppci-8.service
Wants=gsp-runner-fedci@pppci-9.service
Wants=gsp-runner-fedci@pppci-10.service

[Install]
WantedBy=multi-user.target
