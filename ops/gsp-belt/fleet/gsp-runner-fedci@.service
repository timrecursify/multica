[Unit]
Description=GSP federation CI runner %i
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/opt/gsp/runners/fedci-%i/run.sh

[Service]
Type=simple
User=gsp-runner
Slice=gsp-ci.slice
WorkingDirectory=/opt/gsp/runners/fedci-%i
ExecStart=/opt/gsp/runners/fedci-%i/run.sh
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=5min
Environment=RUNNER_ALLOW_RUNASROOT=0

[Install]
WantedBy=multi-user.target
